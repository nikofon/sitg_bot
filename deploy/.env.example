# Copy to .env in the repository root for compose.vps.yaml.
# Hostname only: no https://, path, or trailing slash.
MINI_APP_DOMAIN=mini-app.example.com
BOT_TOKEN=
# Generate each secret separately with: openssl rand -hex 32
# Use a hexadecimal password so it can safely appear in DATABASE_URL.
POSTGRES_PASSWORD=
SITG_APPLICATION_CLIENT_TOKEN=
SITG_ADMIN_TOKEN=
SITG_TOKEN_DELIVERY_KEY=
APPLICATION_SECURITY_KEY=
BOT_LOG_LEVEL=INFO
SITG_DB_MAINTENANCE_ENABLED=false
SITG_DB_SUCCESS_RETENTION_DAYS=7
SITG_DB_FAILURE_RETENTION_DAYS=30
SITG_DB_EXPIRY_GRACE_HOURS=24
# Optional separate website, deployed independently on a different hostname.
WEBSITE_ALLOWED_ORIGINS=[]
